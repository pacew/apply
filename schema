create table notify (
  notify_id int,
  fest_year int,
  test_flag int,
  name_id int,
  confirm int,
  record int,
  email text,
  sent_dttm timestamp,
  responded_dttm timestamp,
  scheduled int
);


create table requests (
  request_id int,       
  app_id int,
  fest_year int,
  test_flag int,
  ts timestamp,
  username text,
  val text,
  dismissed int
);

create table rejected (
  rejected_id int,
  email text,
  fest_year int,
  test_flag int,
  ts timestamp,
  username text,
  reason text
);

create table confirmations (
  name_id int,
  confirmed int,
  record_ok int,
  updated timestamp
);

create table interactions (
  interaction_id int,
  ts timestamp,
  name_id int,
  event text
)
